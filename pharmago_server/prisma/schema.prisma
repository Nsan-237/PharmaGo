// Prisma Schema for PharmaGo Backend Database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  PATIENT
  PHARMACY_ADMIN
  CASHIER
  DELIVERY_AGENT
  PLATFORM_ADMIN
}

enum PrescriptionStatus {
  SUBMITTED
  VERIFIED
  PRICED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  MOMO
  ORANGE_MONEY
  CASH
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  role         Role     @default(PATIENT)
  avatarUrl    String?
  isApproved   Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  pharmacyStaff     PharmacyStaff[]
  patientOrders     Order[]         @relation("PatientOrders")
  deliveryOrders    Order[]         @relation("DeliveryAgentOrders")
  prescriptions     Prescription[]
  sentMessages      Message[]       @relation("SentMessages")
  receivedMessages  Message[]       @relation("ReceivedMessages")
  deliveryLogs      DeliveryLog[]
}

model Pharmacy {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  address      String
  city         String   @default("Douala")
  quarter      String?
  latitude     Float
  longitude    Float
  phone        String
  email        String?
  licenseNo    String?
  isApproved   Boolean  @default(false)
  isGuard247   Boolean  @default(false)
  rating       Float    @default(4.5)
  openingHours String   @default("08:00 - 20:00")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  staff         PharmacyStaff[]
  products      Product[]
  orders        Order[]
  prescriptions Prescription[]
}

model PharmacyStaff {
  id         String   @id @default(uuid())
  pharmacyId String
  userId     String
  role       Role     @default(CASHIER)
  createdAt  DateTime @default(now())

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pharmacyId, userId])
}

model Product {
  id                   String    @id @default(uuid())
  pharmacyId           String
  name                 String
  category             String
  dosage               String?
  description          String?
  price                Float
  stockQuantity        Int       @default(0)
  requiresPrescription Boolean   @default(false)
  imageUrl             String?
  batchNumber          String?
  expiryDate           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  pharmacy   Pharmacy    @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
}

model Prescription {
  id              String             @id @default(uuid())
  patientId       String
  pharmacyId      String?
  imageUrl        String
  notes           String?
  status          PrescriptionStatus @default(SUBMITTED)
  pricedAmount    Float?
  pharmacistNotes String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  patient  User      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  pharmacy Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)
  orders   Order[]
}

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique
  patientId       String
  pharmacyId      String
  deliveryAgentId String?
  prescriptionId  String?
  status          OrderStatus   @default(PENDING)
  totalAmount     Float
  deliveryAddress String
  deliveryLat     Float?
  deliveryLng     Float?
  paymentMethod   PaymentMethod @default(CASH)
  paymentStatus   PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  patient       User          @relation("PatientOrders", fields: [patientId], references: [id])
  pharmacy      Pharmacy      @relation(fields: [pharmacyId], references: [id])
  deliveryAgent User?         @relation("DeliveryAgentOrders", fields: [deliveryAgentId], references: [id])
  prescription  Prescription? @relation(fields: [prescriptionId], references: [id])
  items         OrderItem[]
  messages      Message[]
  deliveryLogs  DeliveryLog[]
}

model OrderItem {
  id          String @id @default(uuid())
  orderId     String
  productId   String
  productName String
  unitPrice   Float
  quantity    Int
  subtotal    Float

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  orderId    String?
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User   @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User   @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  order    Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
}

model DeliveryLog {
  id        String   @id @default(uuid())
  orderId   String
  agentId   String
  lat       Float
  lng       Float
  timestamp DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  agent User  @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

// ─── Security & Audit Models ───────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  // null if done directly in DB
  userEmail  String?
  userRole   String?
  action     String   // e.g. "UPDATE_PRODUCT_PRICE", "DELETE_ORDER", "DIRECT_DB_CHANGE"
  tableName  String   // e.g. "Product", "Order", "Payment"
  recordId   String?  // ID of the affected row
  oldValue   String?  // JSON string of old data
  newValue   String?  // JSON string of new data
  ipAddress  String?
  userAgent  String?
  isSuspicious Boolean @default(false)
  createdAt  DateTime @default(now())
}

model LoginAttempt {
  id         String   @id @default(uuid())
  email      String
  ipAddress  String?
  success    Boolean
  failReason String?
  createdAt  DateTime @default(now())
}

